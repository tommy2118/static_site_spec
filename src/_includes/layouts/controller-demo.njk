---
layout: layouts/base.njk
---
<div class="container mx-auto px-4 py-12 max-w-4xl">
  <p class="sheet-back"><a href="{{ '/controllers/' | url }}" class="hover:text-ink">&larr; Controllers</a></p>
  {% include "partials/sheet-header.njk" %}

  {# Live Demo Section #}
  {% if demoContent %}
  <section class="mb-12">
    <h2 class="sheet-section-title">Live Demo</h2>
    <div class="p-6 bg-wash border border-rule rounded-lg">
      {{ demoContent | safe }}
    </div>
  </section>
  {% endif %}

  {# Main Content #}
  <div class="prose prose-gray max-w-none">
    {{ content | safe }}
  </div>

  {# Prev/Next Navigation #}
  {% include "partials/prev-next.njk" %}
</div>
