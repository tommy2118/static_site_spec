{# Prev/Next Navigation for Documentation Pages #}
{% if prevPage or nextPage %}
<nav class="mt-12 pt-8 border-t border-rule flex justify-between" aria-label="Page navigation">
  {% if prevPage %}
  <a href="{{ prevPage.url | url }}" class="group flex flex-col items-start">
    <span class="text-sm text-ink-faint group-hover:text-ink-soft">&larr; Previous</span>
    <span class="font-medium text-ink group-hover:text-ink-soft">{{ prevPage.title }}</span>
  </a>
  {% else %}
  <div></div>
  {% endif %}

  {% if nextPage %}
  <a href="{{ nextPage.url | url }}" class="group flex flex-col items-end text-right">
    <span class="text-sm text-ink-faint group-hover:text-ink-soft">Next &rarr;</span>
    <span class="font-medium text-ink group-hover:text-ink-soft">{{ nextPage.title }}</span>
  </a>
  {% endif %}
</nav>
{% endif %}
