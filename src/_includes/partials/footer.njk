<footer class="border-t border-rule bg-wash">
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-sm text-ink-soft">
        <p>{{ site.title }} v{{ site.version }}</p>
        <p class="mt-1">&copy; {% year %} {{ site.author }}. MIT License.</p>
      </div>

      <div class="flex items-center gap-6 text-sm">
        <a href="{{ '/changelog/' | url }}" class="text-ink-soft hover:text-ink">Changelog</a>
        {% if site.github %}
        <a href="{{ site.github }}" class="text-ink-soft hover:text-ink">GitHub</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>
