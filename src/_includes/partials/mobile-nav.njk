{# Mobile Navigation Drawer #}
<div data-mobile-nav-target="backdrop" class="mobile-nav-backdrop" aria-hidden="true"
     data-action="click->mobile-nav#closeOnBackdrop"></div>

<nav data-mobile-nav-target="drawer" class="mobile-nav-drawer" aria-label="Mobile navigation">
  <div class="flex items-center justify-between p-4 border-b border-rule">
    <span class="font-semibold text-ink">Navigation</span>
    <button class="p-2 text-ink-faint hover:text-ink" aria-label="Close navigation"
            data-action="click->mobile-nav#close">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="p-4 space-y-6 overflow-y-auto">
    {# Main Section #}
    <div>
      <h3 class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-2">Getting Started</h3>
      {% for item in sections.main %}
      <a href="{{ item.url | url }}"
         class="block py-2 text-ink hover:text-ink {% if page.url == item.url %}font-medium text-ink{% endif %}">
        {{ item.title }}
      </a>
      {% endfor %}
    </div>

    {# Reference Section #}
    <div>
      <h3 class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-2">Reference</h3>
      {% for item in sections.reference %}
      <a href="{{ item.url | url }}"
         class="block py-2 text-ink hover:text-ink {% if page.url == item.url %}font-medium text-ink{% endif %}">
        {{ item.title }}
      </a>
      {% endfor %}
    </div>

    {# Controllers Section #}
    <div>
      <h3 class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-2">Controllers</h3>
      {% for item in sections.controllers %}
      <a href="{{ item.url | url }}"
         class="block py-2 text-ink hover:text-ink {% if page.url == item.url %}font-medium text-ink{% endif %}">
        {{ item.title }}
      </a>
      {% endfor %}
    </div>

    {# Examples Section #}
    <div>
      <h3 class="text-xs font-semibold text-ink-faint uppercase tracking-wide mb-2">More</h3>
      {% for item in sections.examples %}
      <a href="{{ item.url | url }}"
         class="block py-2 text-ink hover:text-ink {% if page.url == item.url %}font-medium text-ink{% endif %}">
        {{ item.title }}
      </a>
      {% endfor %}
    </div>
  </div>
</nav>
