<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{%- set pageTitle = seoTitle or title -%}
<title>{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url | url }}">

{# Open Graph #}
<meta property="og:type" content="website">
<meta property="og:title" content="{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
<meta property="og:site_name" content="{{ site.title }}">

{# Twitter Card #}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if pageTitle %}{{ pageTitle }} | {% endif %}{{ site.title }}">
<meta name="twitter:description" content="{{ description or site.description }}">

{# Fonts - Inter for clean documentation look #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

<link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">
