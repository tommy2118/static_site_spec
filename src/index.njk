---
layout: layouts/base.njk
title: Static Site Spec
description: The canonical architecture and conventions for building modern static websites.
---

{# Hero Section #}
<section class="bg-gray-50 border-b border-gray-200">
  <div class="container mx-auto px-4 py-16 max-w-4xl text-center">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
      Static Site Spec
    </h1>
    <p class="text-xl text-gray-600 mb-8 max-w-2xl mx-auto">
      The canonical architecture and conventions for building modern static websites with Eleventy, Tailwind CSS 4, and Stimulus.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="{{ '/getting-started/' | url }}" class="inline-flex items-center px-6 py-3 bg-gray-900 text-white font-medium rounded-lg hover:bg-gray-800 transition-colors">
        Get Started
      </a>
      <a href="{{ site.github }}" class="inline-flex items-center px-6 py-3 border border-gray-300 text-gray-700 font-medium rounded-lg hover:bg-gray-50 transition-colors">
        View on GitHub
      </a>
    </div>
    <p class="mt-6 text-sm text-gray-500">
      Version {{ site.version }}
    </p>
  </div>
</section>

{# Stack Overview #}
<section class="py-16">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">The Stack</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="text-center" data-controller="animate" data-animate-delay-value="0">
        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Eleventy 3.1.x</h3>
        <p class="text-gray-600 text-sm">Static site generator with Nunjucks templating</p>
      </div>
      <div class="text-center" data-controller="animate" data-animate-delay-value="100">
        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Tailwind CSS 4.1.x</h3>
        <p class="text-gray-600 text-sm">Utility-first CSS with CSS-first configuration</p>
      </div>
      <div class="text-center" data-controller="animate" data-animate-delay-value="200">
        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 mb-2">Stimulus 3.2.x</h3>
        <p class="text-gray-600 text-sm">Lightweight JavaScript behavior framework</p>
      </div>
    </div>
  </div>
</section>

{# Quick Links #}
<section class="py-16 bg-gray-50 border-t border-gray-200">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Documentation</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {% for item in sections.main %}
      <a href="{{ item.url | url }}" class="block p-6 bg-white border border-gray-200 rounded-lg hover:border-gray-300 hover:shadow-sm transition-all">
        <h3 class="font-semibold text-gray-900 mb-2">{{ item.title }}</h3>
        <p class="text-gray-600 text-sm">Learn the fundamentals</p>
      </a>
      {% endfor %}
      {% for item in sections.reference %}
      <a href="{{ item.url | url }}" class="block p-6 bg-white border border-gray-200 rounded-lg hover:border-gray-300 hover:shadow-sm transition-all">
        <h3 class="font-semibold text-gray-900 mb-2">{{ item.title }}</h3>
        <p class="text-gray-600 text-sm">Reference documentation</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# Controllers Section #}
<section class="py-16">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl font-bold text-gray-900 mb-4 text-center">Stimulus Controllers</h2>
    <p class="text-gray-600 text-center mb-8 max-w-2xl mx-auto">
      Pre-built, production-ready controllers for common UI patterns.
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for item in sections.controllers %}
      {% if item.title != "Overview" %}
      <a href="{{ item.url | url }}" class="block p-4 border border-gray-200 rounded-lg hover:border-gray-300 transition-colors">
        <code class="text-sm font-mono text-gray-700">{{ item.title }}</code>
      </a>
      {% endif %}
      {% endfor %}
    </div>
    <div class="text-center mt-8">
      <a href="{{ '/controllers/' | url }}" class="text-blue-600 hover:text-blue-800 font-medium">
        View all controllers &rarr;
      </a>
    </div>
  </div>
</section>

{# Example Sites #}
<section class="py-16 bg-gray-50 border-t border-gray-200">
  <div class="container mx-auto px-4 max-w-4xl">
    <h2 class="text-2xl font-bold text-gray-900 mb-4 text-center">Built with the Spec</h2>
    <p class="text-gray-600 text-center mb-8">
      Real-world sites built following this specification.
    </p>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="p-6 bg-white border border-gray-200 rounded-lg">
        <h3 class="font-semibold text-gray-900 mb-2">Nomad Theater Company</h3>
        <p class="text-gray-600 text-sm mb-2">Theater company website</p>
        <span class="text-xs text-gray-500">v1.2 patterns</span>
      </div>
      <div class="p-6 bg-white border border-gray-200 rounded-lg">
        <h3 class="font-semibold text-gray-900 mb-2">The DBT Resource</h3>
        <p class="text-gray-600 text-sm mb-2">Educational resource site</p>
        <span class="text-xs text-gray-500">v1.3 patterns</span>
      </div>
      <div class="p-6 bg-white border border-gray-200 rounded-lg">
        <h3 class="font-semibold text-gray-900 mb-2">Engineer's Manual</h3>
        <p class="text-gray-600 text-sm mb-2">Technical reference book</p>
        <span class="text-xs text-gray-500">search + TOC patterns</span>
      </div>
    </div>
    <div class="text-center mt-8">
      <a href="{{ '/examples/' | url }}" class="text-blue-600 hover:text-blue-800 font-medium">
        View all examples &rarr;
      </a>
    </div>
  </div>
</section>
